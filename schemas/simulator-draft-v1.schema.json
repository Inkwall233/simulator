{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skilllab.invalid/schemas/simulator-draft-v1.schema.json",
  "title": "SkillLab Simulator Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "draftId",
    "projectId",
    "draftVersion",
    "createdAt",
    "status",
    "packageVersion",
    "source",
    "apiMocks",
    "stateModel",
    "workflows",
    "playbackAdapters",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": "skilllab.simulator-draft.v1" },
    "draftId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "draftVersion": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "const": "DRAFT" },
    "packageVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "sha256", "sizeBytes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "apiDraftId", "sessionId"],
      "properties": {
        "type": { "const": "CAPTURED_TRAFFIC" },
        "apiDraftId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 }
      }
    },
    "apiMocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "items": { "$ref": "#/definitions/apiMockRule" }
        }
      }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "transitions"],
      "properties": {
        "initial": { "type": "object" },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/stateTransition" }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/definitions/workflow" }
    },
    "playbackAdapters": {
      "type": "array",
      "items": { "$ref": "#/definitions/playbackAdapter" }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["NEEDS_REVIEW", "APPROVED", "REJECTED"] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "reviewer": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "definitions": {
    "apiMockRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "status", "requiresReview", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "type": "string", "pattern": "^[A-Z]+$" },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "status": { "type": "integer", "minimum": 200, "maximum": 599 },
        "contentType": { "type": ["string", "null"] },
        "body": {},
        "requiresReview": { "type": "boolean" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiDraftId", "endpointId"],
          "properties": {
            "apiDraftId": { "type": "string", "minLength": 1 },
            "endpointId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onRuleId", "operation", "path"],
      "properties": {
        "onRuleId": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["SET", "MERGE", "INCREMENT", "SET_FROM_REQUEST"] },
        "requestPath": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$" },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "value": {}
      },
      "allOf": [{ "if": { "properties": { "operation": { "const": "SET_FROM_REQUEST" } } }, "then": { "required": ["requestPath"] } }]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "mode", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "mode": { "enum": ["PRACTICE", "EXAM"] },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/workflowStep" }
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "locator", "expectedMatches", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "value"],
          "properties": {
            "strategy": { "enum": ["ROLE_NAME", "LABEL", "TEXT", "CSS"] },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "expectedMatches": { "type": "integer", "minimum": 1, "maximum": 1 },
        "action": { "enum": ["HIGHLIGHT", "WAIT_FOR"] },
        "expectedResult": { "type": "string" },
        "reviewStatus": { "enum": ["NEEDS_REVIEW", "CONFIRMED"] }
      }
    },
    "playbackAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "assetIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["IMAGE_SEQUENCE", "HTML_VIDEO", "MANUAL_REPLACEMENT"] },
        "status": { "enum": ["NEEDS_REVIEW", "READY", "NOT_REQUIRED"] },
        "assetIds": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
