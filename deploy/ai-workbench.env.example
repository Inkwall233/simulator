# Copy to a private env file and replace the example values before startup.
SKILLLAB_CREATOR_USERNAME=creator
# Generate a BCrypt hash outside the repository; never put the plaintext password here.
SKILLLAB_CREATOR_PASSWORD_HASH=replace-with-a-bcrypt-hash
SKILLLAB_ADMIN_ORIGIN=https://skilllab-admin.xyz
AI_RUN_ORIGIN_TEMPLATE=http://{runId}.localhost:3001
AI_WORKER_SHARED_SECRET=replace-with-a-different-long-random-secret

# Exact HTTP/HTTPS origins that this worker is permitted to open.
# Add only devices you are authorized to inspect.
AI_ALLOWED_TARGET_ORIGINS=http://192.168.1.10,https://device.example.internal
AI_ALLOWED_WEBSOCKET_ORIGINS=
AI_SESSION_IDLE_TIMEOUT_MS=1800000

# AI commands stay unavailable until a compatible chat-completions endpoint,
# model and API key are configured. Manual browsing and capture still work.
AI_MODEL=
AI_OPENAI_API_KEY=
AI_OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
AI_IGNORE_HTTPS_ERRORS=false
